---
import YouTubeModal from "./YouTubeModal.astro";

/**
 * A 方案（products.json 存 youtubeId）：
 * - 不渲染本地 mp4，避免 Cloudflare Pages 单文件 25MiB 限制导致部署失败
 * - 显示图片 + “Play product video”按钮，点击后弹窗播放 YouTube
 *
 * 支持两种传参方式：
 * 1) <ProductMedia asin="" images={[]} youtubeId="" />
 * 2) <ProductMedia product={product} />
 */
const { asin: asinProp, images: imagesProp, youtubeId: youtubeIdProp, product } = Astro.props;

const asin = asinProp ?? product?.asin ?? "";
const images = imagesProp ?? product?.images ?? [];
const youtubeId = youtubeIdProp ?? product?.youtubeId ?? "";

// 将图片路径统一成 /images/{asin}/{filename}（如果已是 "/images/..." 这种绝对路径则原样返回）
function imgSrc(p: string) {
  if (!p) return "";
  if (p.startsWith("/")) return p;
  return `/images/${asin}/${p}`;
}
---

<div class="product-media">
  {images?.length > 0 ? (
    <div class="product-images">
      {images.map((img, idx) => (
        <figure class="product-image" key={`${asin}-${idx}`}>
          <img src={imgSrc(img)} alt={`${asin} image ${idx + 1}`} loading="lazy" />
        </figure>
      ))}
    </div>
  ) : (
    <p>No images</p>
  )}

  {youtubeId ? (
    <div class="product-video">
      <YouTubeModal youtubeId={youtubeId} />
    </div>
  ) : null}
</div>

<style>
  .product-images {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 12px;
    margin: 12px 0;
  }

  .product-image {
    margin: 0;
  }

  .product-image img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 10px;
    border: 1px solid rgba(0,0,0,0.08);
  }

  .product-video {
    margin-top: 12px;
  }

  @media (min-width: 900px) {
    .product-images {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
