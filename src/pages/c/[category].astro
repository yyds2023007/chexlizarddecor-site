---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("products", (p) => p.data.published);
  const categories = Array.from(new Set(items.map((p) => p.data.category)));
  return categories.map((category) => ({
    params: { category }, // 这里不要 encodeURIComponent
  }));
}
const category = decodeURIComponent(Astro.params.category);
const items = await getCollection(
  "products",
  (p) => p.data.published && p.data.category === category
);
---

<BaseLayout title={category} description={`Products in category: ${category}`}>
  <h1>{category}</h1>
  <ul>
    {items.map((p) => (
      <li>
        <a href={`/p/${p.slug}/`}>{p.data.title}</a>
        <div class="muted">{p.data.summary}</div>
      </li>
    ))}
  </ul>
</BaseLayout>
