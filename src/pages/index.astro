---
import BaseLayout from "../layouts/BaseLayout.astro";
import products from "../data/products.json";

const list = (products ?? []).filter((p) => p?.published === true);
---

<BaseLayout>
  <div class="grid">
    {list.map((p) => {
      const asin = p?.asin;
      if (!asin) return null;

      const title = p?.title ?? asin;
      const summary = p?.summary ?? "";
      const amazonUrl = p?.amazonUrl ?? `https://www.amazon.com/dp/${asin}`;
      const detailsUrl = `/products/${asin}/`;

      // 首页只展示图片，不再展示本地 mp4
      const imageUrl =
        (Array.isArray(p?.images) && p.images?.[0]) || `/images/${asin}/${asin}-1.png`;

      return (
        <article class="card">
          <a class="media" href={detailsUrl}>
            <img src={imageUrl} alt={title} loading="lazy" />
          </a>

          <div class="body">
            <h3 class="title">
              <a href={detailsUrl}>{title}</a>
            </h3>

            {summary ? <p class="summary">{summary}</p> : null}

            <div class="actions">
              <a class="btn primary" href={amazonUrl} target="_blank" rel="noopener noreferrer">
                Buy on Amazon
              </a>
              <a class="btn" href={detailsUrl}>
                Details
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 900px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }

  .card {
    border: 1px solid #e5e7eb;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
  }

  .media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .body {
    padding: 14px 14px 16px;
  }

  .title {
    margin: 0 0 8px;
    font-size: 18px;
    line-height: 1.2;
  }

  .title a {
    color: inherit;
    text-decoration: none;
  }

  .summary {
    margin: 0 0 14px;
    color: #6b7280;
  }

  .actions {
    display: flex;
    gap: 12px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border-radius: 10px;
    border: 1px solid #d1d5db;
    text-decoration: none;
    color: #111827;
    background: #fff;
  }

  .btn.primary {
    background: #2563eb;
    border-color: #2563eb;
    color: #fff;
  }
</style>
