---
import BaseLayout from "../layouts/BaseLayout.astro";
import products from "../data/products.json";

const list = (products ?? []).filter((p) => p?.published === true);
---

<BaseLayout title="ChexLizardDecor" description="Browse products and buy on Amazon.">
  <style>
    .grid { display: grid; grid-template-columns: 1fr; gap: 18px; padding: 0; margin: 0; list-style: none; }
    @media (min-width: 900px) { .grid { grid-template-columns: 1fr 1fr; } }

    .card { border: 1px solid #eee; border-radius: 12px; padding: 14px; }
    .title { margin: 0 0 6px 0; font-size: 18px; font-weight: 800; }
    .title a { color: inherit; text-decoration: none; }
    .title a:hover { text-decoration: underline; }
    .summary { margin: 0 0 12px 0; color: #333; }

    .mediaBox { width: 100%; border-radius: 12px; border: 1px solid #f2f2f2; overflow: hidden; background: #fafafa; }
    .mediaBox > img, .mediaBox > video { width: 100%; height: 100%; display: block; object-fit: cover; }
    .imageBox { aspect-ratio: 1 / 1; }
    .videoBox { aspect-ratio: 16 / 9; }

    .btnRow { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 12px; }
    .btn { display: inline-block; padding: 10px 14px; border-radius: 8px; border: 1px solid #0b57d0; text-decoration: none; }
    .btnPrimary { background: #0b57d0; color: #fff; }
    .btnSecondary { border-color: #ddd; color: #111; }
    .warn { margin-top: 10px; color: #666; font-size: 13px; }
  </style>

  <ul class="grid">
    {list.map((p) => {
      const asin = p?.asin;
      if (!asin) return null;

      const title = p?.title ?? asin;
      const summary = p?.summary ?? "";
      const amazonUrl = p?.amazonUrl ?? `https://www.amazon.com/dp/${asin}`;
      const detailsUrl = `/products/${asin}/`;

      const imageUrl = `/images/${asin}/${asin}-1.png`;
      const videoUrl = `/videos/${asin}/${asin}.mp4`;

      return (
        <li class="card">
          <h2 class="title"><a href={detailsUrl}>{title}</a></h2>
          {summary ? <p class="summary">{summary}</p> : null}

          <div class="mediaBox imageBox">
            <img src={imageUrl} alt={title} loading="lazy" decoding="async" />
          </div>

          <div style="height: 12px;"></div>

          <div class="mediaBox videoBox">
            <video src={videoUrl} poster={imageUrl} controls muted playsinline preload="metadata"></video>
          </div>

          <div class="btnRow">
            <a class="btn btnPrimary" href={amazonUrl} target="_blank" rel="noopener noreferrer">Buy on Amazon</a>
            <a class="btn btnSecondary" href={detailsUrl}>Details</a>
          </div>

          <div class="warn">If image/video shows blank, check files in /public/images and /public/videos.</div>
        </li>
      );
    })}
  </ul>
</BaseLayout>
