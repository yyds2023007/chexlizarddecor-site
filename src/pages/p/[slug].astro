---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("products", (p) => p.data.published);
  return items.map((p) => ({ params: { slug: p.slug } }));
}

const items = await getCollection("products");
const product = items.find((p) => p.slug === Astro.params.slug);
if (!product) throw new Error("Product not found");

const { Content } = await product.render();
---

<BaseLayout title={product.data.title} description={product.data.summary}>
  <p><a href="/">← Back</a></p>
  <h1>{product.data.title}</h1>
  <p class="muted">{product.data.summary}</p>

  <p>
    <a href={product.data.amazon_url} target="_blank" rel="sponsored nofollow noopener">
      Check price on Amazon
    </a>
  </p>

  <Content />
</BaseLayout>
