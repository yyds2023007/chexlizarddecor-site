---
const BRAND = "ChexLizardDecor";
const SUPPORT_EMAIL = "support@chexlizarddecor.com";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Payment | {BRAND}</title>
  </head>
  <body>
    <main style="max-width:900px;margin:24px auto;padding:0 16px;font-family:system-ui;">
      <h1>Payment</h1>
      <p>
        Payments are processed via Payoneer payment requests (invoices). You may be redirected to a secure Payoneer invoice page to complete payment by card or bank transfer.
      </p>
      <p>
        If you have any questions, contact {SUPPORT_EMAIL}.
      </p>
    </main>
  </body>
</html>
