---
const BRAND = "ChexLizardDecor";
const SUPPORT_EMAIL = "support@chexlizarddecor.com";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Privacy Policy | {BRAND}</title>
  </head>
  <body>
    <main style="max-width:900px;margin:24px auto;padding:0 16px;font-family:system-ui;">
      <h1>Privacy Policy</h1>
      <p>
        We collect only the information needed to respond to messages and fulfill orders (for example: name, email, shipping address, and order details).
      </p>
      <ul>
        <li>We do not sell your personal information.</li>
        <li>We use your information to provide customer support and complete your order.</li>
        <li>For questions, contact {SUPPORT_EMAIL}.</li>
      </ul>
    </main>
  </body>
</html>
