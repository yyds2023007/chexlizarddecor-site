---
import BaseLayout from "../../layouts/BaseLayout.astro";
import products from "../../data/products.json";
import ProductMedia from "../../components/ProductMedia.astro";

export async function getStaticPaths() {
  const live = products.filter((p) => p.published === true);
  return live.map((p) => ({
    params: { slug: p.asin },
    props: { product: p },
  }));
}

const { product } = Astro.props;
if (!product) return new Response("Not found", { status: 404 });

const asin = product.asin;
---

<BaseLayout title={product.title} description={product.summary}>
  <a href="/">← Back</a>

  <h1>{product.title}</h1>
  <p>{product.summary}</p>

  <ProductMedia asin={asin} />

  <p>
    <a href={product.amazonUrl} target="_blank" rel="noopener noreferrer">Buy on Amazon</a>
  </p>

  <a href="/">← Back</a>
</BaseLayout>
