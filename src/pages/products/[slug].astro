---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductMedia from "../../components/ProductMedia.astro";
import products from "../../data/products.json";

// 生成静态路由：/products/<asin>/
export async function getStaticPaths() {
  const list = (products ?? []).filter((p) => p?.published === true && p?.asin);
  return list.map((p) => ({ params: { slug: p.asin } }));
}

const { slug } = Astro.params;

// 通过 slug(asin) 找到对应产品数据
const product = (products ?? []).find((p) => p?.asin === slug);

const asin = product?.asin ?? slug;
const title = product?.title ?? asin;
const summary = product?.summary ?? "";
const amazonUrl = product?.amazonUrl ?? `https://www.amazon.com/dp/${asin}`;

// 关键：把 images / youtubeId 传给 ProductMedia
const images = product?.images ?? [];
const youtubeId = product?.youtubeId ?? "";
---

<BaseLayout>
  <a href="/">← Back</a>

  <h1>{title}</h1>

  <!-- 首屏披露：Amazon Operating Agreement 要求清晰显眼展示 -->
  <div class="amazon-disclosure" role="note" aria-label="Amazon affiliate disclosure">
    As an Amazon Associate I earn from qualifying purchases.
  </div>

  {summary ? <p>{summary}</p> : null}

  <!-- 卖点：通用且不需要你每个产品手改 -->
  <ul class="bullets" aria-label="Product highlights">
    <li>Solar-powered outdoor decor light—no wiring needed.</li>
    <li>Waterproof design for patio, porch, yard, and balcony use.</li>
    <li>Cordless and easy to move for seasonal decorating.</li>
    <li>A fun accent piece that adds a warm glow at night.</li>
    <li>Great gift idea for garden and outdoor decor lovers.</li>
  </ul>

  <!-- 主按钮放在图片前，提高点击率 -->
  <p class="cta">
    <a class="btn primary" href={amazonUrl} target="_blank" rel="noopener noreferrer">
      Buy on Amazon
    </a>
    <span class="small-disclosure">(paid link)</span>
  </p>

  <ProductMedia asin={asin} images={images} youtubeId={youtubeId} />

  <!-- 页面底部再放一次按钮 -->
  <p class="cta">
    <a class="btn primary" href={amazonUrl} target="_blank" rel="noopener noreferrer">
      Buy on Amazon
    </a>
    <span class="small-disclosure">(paid link)</span>
  </p>

  <p><a href="/">← Back</a></p>

  <style>
    .bullets {
      margin: 12px 0 14px;
      padding-left: 18px;
    }
    .bullets li {
      margin: 6px 0;
    }
    .cta {
      margin: 12px 0 14px;
    }
    .btn {
      display: inline-block;
      padding: 10px 14px;
      border-radius: 10px;
      border: 1px solid rgba(0, 0, 0, 0.18);
      text-decoration: none;
    }
    .btn.primary {
      background: #1d4ed8;
      border-color: #1d4ed8;
      color: #fff;
    }
    .small-disclosure {
      display: inline-block;
      margin-left: 10px;
      font-size: 12px;
      line-height: 1.4;
      opacity: 0.85;
    }
  </style>
</BaseLayout>
