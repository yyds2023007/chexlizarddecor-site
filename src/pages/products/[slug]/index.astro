---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const products = await getCollection("products", (p) => p.data.published === true);
  return products.map((p) => ({
    params: { slug: p.slug },
  }));
}

const { slug } = Astro.params;

const products = await getCollection("products", (p) => p.data.published === true);
const product = products.find((p) => p.slug === slug);

// 如果没找到，直接返回 404（避免 product 为 undefined）
if (!product) {
  return new Response("Not found", { status: 404 });
}

const { Content } = await product.render();

const BRAND = "ChexLizardDecor";
const SUPPORT_EMAIL = "support@chexlizarddecor.com";

const title = product.data.title ?? product.slug;
const summary = product.data.summary ?? "";
const image = product.data.cover_image ?? "";
const amazonUrl = product.data.amazon_url ?? "";
const payoneerUrl = product.data.payoneer_url ?? "";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title} | {BRAND}</title>
    {summary ? <meta name="description" content={summary} /> : null}
  </head>

  <body>
    <main style="max-width:900px;margin:24px auto;padding:0 16px;font-family:system-ui;">
      <a href="/products/">← Back to Products</a>
      <h1>{title}</h1>

      {image ? (
        <img src={image} alt={title} style="max-width:100%;border-radius:12px;margin:12px 0;" />
      ) : null}

      <div style="display:flex;gap:12px;flex-wrap:wrap;margin:16px 0;">
        {payoneerUrl ? (
          <a
            href={payoneerUrl}
            style="padding:10px 14px;border-radius:10px;background:#111;color:#fff;text-decoration:none;"
            rel="noopener noreferrer"
            target="_blank"
          >
            Pay invoice (Card/Bank Transfer)
          </a>
        ) : (
          <a
            href="/payment"
            style="padding:10px 14px;border-radius:10px;background:#444;color:#fff;text-decoration:none;"
          >
            Request invoice (Payoneer)
          </a>
        )}

        {amazonUrl ? (
          <a
            href={amazonUrl}
            style="padding:10px 14px;border-radius:10px;background:#0b5;color:#fff;text-decoration:none;"
            rel="noopener noreferrer"
            target="_blank"
          >
            Buy on Amazon
          </a>
        ) : null}

        <a
          href="/contact"
          style="padding:10px 14px;border-radius:10px;background:#eee;color:#111;text-decoration:none;border:1px solid #ddd;"
        >
          Contact
        </a>
      </div>
