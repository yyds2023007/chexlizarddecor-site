---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const items = await getCollection("products", (p) => p.data.published);
  const tags = Array.from(new Set(items.flatMap((p) => p.data.tags)));
  return tags.map((tag) => ({
    params: { tag: encodeURIComponent(tag) },
  }));
}

const tag = decodeURIComponent(Astro.params.tag);
const items = await getCollection(
  "products",
  (p) => p.data.published && p.data.tags.includes(tag)
);
---

<BaseLayout title={`Tag: ${tag}`} description={`Products tagged: ${tag}`}>
  <h1>Tag: {tag}</h1>
  <ul>
    {items.map((p) => (
      <li>
        <a href={`/p/${p.slug}/`}>{p.data.title}</a>
        <div class="muted">{p.data.summary}</div>
      </li>
    ))}
  </ul>
</BaseLayout>
